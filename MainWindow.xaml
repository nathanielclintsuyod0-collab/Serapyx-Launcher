<Window x:Class="SeraphyxLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seraphyx Launcher" Height="840" Width="1320"
        MinHeight="720" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Icon="icon.ico"
        Background="{StaticResource Bg}" Foreground="#F7F2FF"
        FontFamily="Segoe UI" UseLayoutRounding="True">

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Entrance: sidebar, header, then each card in turn -->
                    <DoubleAnimation Storyboard.TargetName="Sidebar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5" EasingFunction="{StaticResource EaseOutCubic}" />
                    <DoubleAnimation Storyboard.TargetName="Sidebar" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.55" EasingFunction="{StaticResource EaseOutCubic}" />

                    <DoubleAnimation Storyboard.TargetName="HeaderBar" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.05" Duration="0:0:0.5" EasingFunction="{StaticResource EaseOutCubic}" />
                    <DoubleAnimation Storyboard.TargetName="HeaderBar" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" BeginTime="0:0:0.05" Duration="0:0:0.55" EasingFunction="{StaticResource EaseOutCubic}" />

                    <DoubleAnimation Storyboard.TargetName="HeroCard" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.12" Duration="0:0:0.6" EasingFunction="{StaticResource EaseOutCubic}" />
                    <DoubleAnimation Storyboard.TargetName="HeroCard" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" BeginTime="0:0:0.12" Duration="0:0:0.65" EasingFunction="{StaticResource EaseOutCubic}" />

                    <DoubleAnimation Storyboard.TargetName="AccountRow" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.24" Duration="0:0:0.6" EasingFunction="{StaticResource EaseOutCubic}" />
                    <DoubleAnimation Storyboard.TargetName="AccountRow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" BeginTime="0:0:0.24" Duration="0:0:0.65" EasingFunction="{StaticResource EaseOutCubic}" />

                    <DoubleAnimation Storyboard.TargetName="SetupCard" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.36" Duration="0:0:0.6" EasingFunction="{StaticResource EaseOutCubic}" />
                    <DoubleAnimation Storyboard.TargetName="SetupCard" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" BeginTime="0:0:0.36" Duration="0:0:0.65" EasingFunction="{StaticResource EaseOutCubic}" />

                    <!-- Ambient loops: floating hero graphic, breathing glow, pulsing status dot and launch button -->
                    <DoubleAnimation Storyboard.TargetName="HeroGraphic" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-9" BeginTime="0:0:1.0" Duration="0:0:2.8" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="BackdropGlow" Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:0:5" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="StatusDot" Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever" />
                    <DoubleAnimation Storyboard.TargetName="LaunchGlow" Storyboard.TargetProperty="Opacity" From="0.25" To="0.7" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Soft purple glow behind everything -->
        <Ellipse x:Name="BackdropGlow" Grid.ColumnSpan="2" Width="980" Height="620"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-320,-260,0"
                 IsHitTestVisible="False" Opacity="0.7">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#3A8B63E0" Offset="0" />
                    <GradientStop Color="#008B63E0" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Sidebar -->
        <Border x:Name="Sidebar" Grid.Column="0" Background="#100C1C" BorderBrush="#302442" BorderThickness="0,0,1,0" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform X="-36" />
            </Border.RenderTransform>
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="16,24,16,18">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                        <Grid Width="34" Height="34" Margin="0,0,11,0">
                            <Rectangle Width="12" Height="12" Fill="#D9CCFF" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <Rectangle Width="12" Height="12" Fill="#9B75EF" HorizontalAlignment="Right" VerticalAlignment="Top" />
                            <Rectangle Width="12" Height="12" Fill="#7651C5" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                            <Rectangle Width="12" Height="12" Fill="#B69AF7" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="SERAPHYX" FontSize="17" FontWeight="Black" />
                            <TextBlock Text="JAVA LAUNCHER" FontSize="9" Foreground="{StaticResource Muted}" Margin="1,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="#302442" Margin="5,22,5,18" />
                    <TextBlock Text="LAUNCHER" Foreground="#796A94" FontSize="10" FontWeight="Bold" Margin="13,0,0,8" />

                    <RadioButton Style="{StaticResource NavRadio}" GroupName="Nav" IsChecked="True" Click="NavigateHome_Click" Content="Home" />
                    <RadioButton Style="{StaticResource NavRadio}" GroupName="Nav" Click="NavigateModrinth_Click" Content="Modrinth library" />
                    <RadioButton Style="{StaticResource NavRadio}" GroupName="Nav" Click="NavigateOptimizer_Click" Content="Performance optimizer" />
                    <RadioButton Style="{StaticResource NavRadio}" GroupName="Nav" Click="NavigateAbout_Click" Content="About this launcher" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="20,14,20,22">
                    <Border Background="#1B142B" BorderBrush="#3B2D58" BorderThickness="1" CornerRadius="10" Padding="13">
                        <StackPanel>
                            <TextBlock Text="SERAPHYX SMP" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="Java Edition" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                            <TextBlock Text="Authentication required to join" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Independent community launcher" FontSize="10" Foreground="#786C8B" Margin="2,13,0,0" />
                    <TextBlock x:Name="VersionLabel" Text="v1.0.0" FontSize="10" Foreground="#9588AA" Margin="2,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1" Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderBar" Grid.Row="0" Margin="0,0,0,18" Opacity="0">
                <Grid.RenderTransform>
                    <TranslateTransform Y="-14" />
                </Grid.RenderTransform>
                <StackPanel>
                    <TextBlock x:Name="PageEyebrow" Text="SERAPHYX / JAVA EDITION" FontSize="10" Foreground="#BBA8E8" FontWeight="Bold" />
                    <TextBlock x:Name="PageTitle" Text="Your realm is waiting" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#171126" BorderBrush="#3B2D58" BorderThickness="1" CornerRadius="18" Padding="13,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Green}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="ModeBadge" Text="SIGN-IN REQUIRED" FontSize="10" Foreground="#D7CAE9" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1">

                <!-- ============ HOME ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="HomeView" Margin="0,0,6,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="HeroCard" Grid.Row="0" Style="{StaticResource Card}" Background="{StaticResource HeroBrush}" BorderBrush="#5B4581" Padding="26" Margin="0,0,0,16" Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform Y="26" />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="THE ASCENSION BEGINS" FontSize="10" Foreground="#C6B2F2" FontWeight="Bold" />
                                    <TextBlock Text="Enter Seraphyx" FontSize="30" FontWeight="SemiBold" Margin="0,9,0,0" />
                                    <TextBlock Text="Choose how to play, pick a version, and jump into Seraphyx. Browse mods and packs any time." FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="560" Margin="0,8,0,0" />
                                </StackPanel>
                                <Grid x:Name="HeroGraphic" Grid.Column="1" Width="150" Height="114" Margin="24,0,0,0">
                                    <Grid.RenderTransform>
                                        <TranslateTransform Y="0" />
                                    </Grid.RenderTransform>
                                    <Ellipse Width="230" Height="230" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#559B75EF" Offset="0" />
                                                <GradientStop Color="#009B75EF" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Rectangle Width="44" Height="44" Fill="#372657" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,4,0,0" RadiusX="4" RadiusY="4" />
                                    <Rectangle Width="44" Height="44" Fill="#5F438F" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,8,0" RadiusX="4" RadiusY="4" />
                                    <Rectangle Width="44" Height="44" Fill="#8E6BD3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,4" RadiusX="4" RadiusY="4" />
                                    <Rectangle Width="44" Height="44" Fill="#2B1F42" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,4" RadiusX="4" RadiusY="4" />
                                    <Rectangle Width="28" Height="28" Fill="#D9CCFF" HorizontalAlignment="Center" VerticalAlignment="Center" RadiusX="3" RadiusY="3" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid x:Name="AccountRow" Grid.Row="1" Margin="0,0,0,16" Opacity="0">
                            <Grid.RenderTransform>
                                <TranslateTransform Y="26" />
                            </Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="0.95*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="SIGN-IN MODE" FontSize="10" Foreground="#BBA8E8" FontWeight="Bold" />
                                    <ComboBox x:Name="ModeBox" Style="{StaticResource ComboField}" Margin="0,10,0,0" SelectedIndex="0" SelectionChanged="ModeBox_SelectionChanged">
                                        <ComboBoxItem Content="Online — Microsoft account" Tag="Online" />
                                        <ComboBoxItem Content="Offline — local single-player, no Microsoft" Tag="Offline" />
                                    </ComboBox>
                                    <TextBlock x:Name="ModeDescription" Text="Sign in with Microsoft and launch directly into Seraphyx. A valid Java profile is required." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,9,0,0" />
                                    <Button x:Name="SignInButton" Style="{StaticResource ButtonBase}" Content="Sign in with Microsoft" Click="SignIn_Click" Margin="0,14,0,0" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="AccountStatus" Text="No Microsoft profile connected" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="LOCAL LAUNCHER PROFILE" FontSize="10" Foreground="#BBA8E8" FontWeight="Bold" />
                                    <TextBlock Text="Used as your local single-player profile" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,10" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource ButtonBase}" Content="Save" Click="SaveLocalProfile_Click" Padding="14,10" Margin="9,0,0,0" />
                                        <TextBox x:Name="LocalProfileBox" Style="{StaticResource Field}" MaxLength="16" ToolTip="Launcher display name; not a Minecraft login" />
                                    </DockPanel>
                                    <TextBlock Text="Offline mode uses this name locally. It does not grant multiplayer or server access." FontSize="10" Foreground="#A79ABF" TextWrapping="Wrap" Margin="0,9,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border x:Name="SetupCard" Grid.Row="2" Style="{StaticResource Card}" Padding="20" Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform Y="26" />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Row="0">
                                    <TextBlock Text="GAME SETUP" FontSize="10" Foreground="#BBA8E8" FontWeight="Bold" />
                                    <TextBlock Text=" / Private Seraphyx instance" FontSize="10" Foreground="{StaticResource Muted}" />
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Minecraft version" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                                        <ComboBox x:Name="VersionBox" Style="{StaticResource ComboField}" IsEditable="False" MaxDropDownHeight="420" SelectionChanged="VersionBox_SelectionChanged" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Game profile" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                                        <ComboBox x:Name="GameLoaderBox" Style="{StaticResource ComboField}" SelectedIndex="0" SelectionChanged="GameLoaderBox_SelectionChanged">
                                            <ComboBoxItem Content="Vanilla" Tag="Vanilla" />
                                            <ComboBoxItem Content="Fabric" Tag="Fabric" />
                                            <ComboBoxItem Content="Quilt" Tag="Quilt" />
                                            <ComboBoxItem Content="OptiFine" Tag="OptiFine" />
                                        </ComboBox>
                                        <Button x:Name="OptiFineHelpButton" Style="{StaticResource ButtonBase}" Content="Get OptiFine…" Click="GetOptiFine_Click"
                                                Visibility="Collapsed" HorizontalAlignment="Left" FontSize="11" Padding="12,7" Margin="0,8,0,0"
                                                ToolTip="OptiFine can only be downloaded from optifine.net. This opens the page and shows the install steps." />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,20,0,0">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,200,0">
                                        <TextBlock x:Name="StatusText" Text="Choose a mode above." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                        <ProgressBar x:Name="LaunchProgress" Height="5" Minimum="0" Maximum="100" Value="0" Margin="0,9,0,0" Background="#2A203A" Foreground="#9B75EF" BorderThickness="0" Visibility="Collapsed" />
                                    </StackPanel>
                                    <Button x:Name="LaunchButton" Style="{StaticResource AccentButton}" Content="LAUNCH SERAPHYX" Click="Launch_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="26,14" FontSize="14">
                                        <Button.Effect>
                                            <DropShadowEffect x:Name="LaunchGlow" Color="#9468F0" BlurRadius="22" ShadowDepth="0" Opacity="0.45" />
                                        </Button.Effect>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- ============ MODRINTH ============ -->
                <ScrollViewer x:Name="ModrinthView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="0,0,6,12">
                        <Border Style="{StaticResource Card}" Background="{StaticResource HeroBrush}" BorderBrush="#5B4581" Padding="24" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="MODRINTH / COMMUNITY CONTENT" FontSize="10" Foreground="#D0BFFF" FontWeight="Bold" />
                                    <TextBlock Text="Build your game your way" FontSize="26" FontWeight="SemiBold" Margin="0,7,0,0" />
                                    <TextBlock Text="Discover mods, modpacks, resource packs, and shaders for your selected Minecraft version." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="690" Margin="0,7,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ButtonBase}" Content="Open game folder" Click="OpenGameFolder_Click" VerticalAlignment="Center" Margin="16,0,0,0" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CONTENT TYPE" FontSize="10" Foreground="#BBA8E8" FontWeight="Bold" Margin="0,0,0,6" />
                                    <ComboBox x:Name="ModrinthTypeBox" Style="{StaticResource ComboField}" SelectedIndex="0" SelectionChanged="ModrinthTypeBox_SelectionChanged">
                                        <ComboBoxItem Content="Mods" Tag="mod" />
                                        <ComboBoxItem Content="Modpacks" Tag="modpack" />
                                        <ComboBoxItem Content="Resource packs" Tag="resourcepack" />
                                        <ComboBoxItem Content="Shaders" Tag="shader" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SEARCH MODRINTH" FontSize="10" Foreground="#BBA8E8" FontWeight="Bold" Margin="0,0,0,6" />
                                    <TextBox x:Name="ModrinthSearchBox" Style="{StaticResource Field}" ToolTip="Search Modrinth" KeyDown="ModrinthSearchBox_KeyDown" />
                                </StackPanel>
                                <Button x:Name="ModrinthSearchButton" Grid.Column="4" Style="{StaticResource AccentButton}" Content="Search" Click="SearchModrinth_Click" VerticalAlignment="Bottom" Padding="22,11" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardFlat}" Background="#171126" BorderBrush="#3B2D58" CornerRadius="9" Padding="14" Margin="0,0,0,14">
                            <TextBlock Text="Compatible mods install with Fabric or Quilt. Modpacks install their included client files and supported loader. Resource packs work on vanilla; shaders need a shader mod such as Iris. Everything installs to this launcher’s shared game folder, so use one modpack at a time." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                        </Border>

                        <Grid Margin="2,0,2,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="ModrinthResultCount" Text="Search Modrinth to explore community content." FontSize="12" Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="ModrinthStatusText" Text="Ready to browse." FontSize="10" Foreground="#9588AA" Margin="0,4,0,0" />
                                <ProgressBar x:Name="ModrinthProgress" Height="3" IsIndeterminate="True" Margin="0,8,0,0" Background="#2A203A" Foreground="#A985F7" BorderThickness="0" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="SORTED BY DOWNLOADS" FontSize="9" Foreground="#86779E" VerticalAlignment="Top" />
                        </Grid>

                        <ItemsControl x:Name="ModrinthResults">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardFlat}" Padding="16" Margin="0,0,0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#F7F2FF" />
                                                    <Border Background="#302348" CornerRadius="9" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TypeLabel}" FontSize="9" Foreground="#D9CCFF" />
                                                    </Border>
                                                    <TextBlock Text="{Binding DownloadsLabel}" FontSize="10" Foreground="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Byline}" FontSize="10" Foreground="#A99BC1" Margin="0,5,0,0" />
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding VersionLabel}" FontSize="9" Foreground="#9688AA" Margin="0,6,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource ButtonBase}" Content="View" Tag="{Binding}" Click="OpenModrinthProject_Click" Margin="0,0,8,0" Padding="13,9" />
                                                <Button Style="{StaticResource AccentButton}" Content="Install" Tag="{Binding}" Click="InstallModrinthProject_Click" Padding="15,9" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ OPTIMIZER ============ -->
                <ScrollViewer x:Name="OptimizerView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="0,0,6,12">
                        <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="PERFORMANCE OPTIMIZER" FontSize="10" Foreground="#BBA8E8" FontWeight="Bold" />
                                <TextBlock Text="Tune the game instance" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Text="These settings affect the Seraphyx launcher’s separate Minecraft folder. The optimizer changes game memory and video settings; it does not run system cleaners or make registry changes." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="760" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="CHOOSE A PRESET" FontSize="10" Foreground="#BBA8E8" FontWeight="Bold" />
                                <UniformGrid Columns="3" Margin="0,13,0,0">
                                    <Button Style="{StaticResource ButtonBase}" Content="Balanced" Click="BalancedPreset_Click" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource ButtonBase}" Content="Higher FPS" Click="PerformancePreset_Click" Margin="4,0" />
                                    <Button Style="{StaticResource ButtonBase}" Content="Visual quality" Click="QualityPreset_Click" Margin="8,0,0,0" />
                                </UniformGrid>
                                <TextBlock x:Name="PresetDescription" Text="Balanced: moderate view distance and memory for typical play." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,11,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="MEMORY ALLOCATION" FontSize="10" Foreground="#BBA8E8" FontWeight="Bold" />
                                    <TextBlock x:Name="MemoryLabel" DockPanel.Dock="Right" Text="4096 MB" FontSize="13" Foreground="{StaticResource Lavender}" FontWeight="Bold" />
                                </DockPanel>
                                <Slider x:Name="MemorySlider" Minimum="2048" Maximum="8192" Value="4096" TickFrequency="512" IsSnapToTickEnabled="True" ValueChanged="MemorySlider_ValueChanged" Margin="0,14,0,0" />
                                <TextBlock Text="The slider is capped at a conservative share of detected system memory. More allocated RAM is not always faster." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Background="#211936" BorderBrush="#544078" Padding="20">
                            <Grid>
                                <StackPanel Margin="0,0,220,0">
                                    <TextBlock Text="INSTANCE SETTINGS" FontSize="10" Foreground="#D9CCFF" FontWeight="Bold" />
                                    <TextBlock Text="Apply a preset to the isolated Seraphyx game profile. Existing settings are backed up before they are changed." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0" />
                                </StackPanel>
                                <Button Style="{StaticResource AccentButton}" Content="APPLY OPTIMIZATION" Click="ApplyOptimization_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ ABOUT ============ -->
                <ScrollViewer x:Name="AboutView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="26" VerticalAlignment="Top" Margin="0,0,6,12">
                        <StackPanel>
                            <TextBlock Text="ABOUT SERAPHYX LAUNCHER" FontSize="10" Foreground="#BBA8E8" FontWeight="Bold" />
                            <TextBlock Text="An independent launcher for Seraphyx SMP" FontSize="24" FontWeight="SemiBold" Margin="0,9,0,0" />
                            <TextBlock Text="This launcher is not affiliated with Microsoft or Mojang Studios. Microsoft sign-in is handled by the authentication library; the launcher never asks for your Microsoft password directly." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <TextBlock Text="Offline mode uses your local nickname for single-player and does not require Microsoft sign-in; game files may still need to download on first launch. Use Online mode and a valid Java Edition profile to connect to Seraphyx." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            <TextBlock Text="OptiFine is a separate product with its own download page. Choose the OptiFine game profile and the launcher will guide you through installing it, then start it for you." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="2" Margin="0,17,0,0">
                <TextBlock Text="SERAPHYX COMMUNITY SOFTWARE" FontSize="9" Foreground="#756987" />
                <TextBlock x:Name="FooterHint" Text="Multiplayer requires Microsoft sign-in." FontSize="10" Foreground="#9588AA" HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Grid>
</Window>
