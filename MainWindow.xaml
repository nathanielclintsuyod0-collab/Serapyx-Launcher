<Window x:Class="SeraphyxLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seraphyx Launcher" Height="760" Width="1180"
        MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="#F7F2FF"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#100C1C" BorderBrush="#302442" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="21,24,18,18">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="34" Height="34" Margin="0,0,11,0">
                            <Rectangle Width="12" Height="12" Fill="#D9CCFF" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <Rectangle Width="12" Height="12" Fill="#9B75EF" HorizontalAlignment="Right" VerticalAlignment="Top" />
                            <Rectangle Width="12" Height="12" Fill="#7651C5" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                            <Rectangle Width="12" Height="12" Fill="#B69AF7" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="SERAPHYX" FontSize="17" FontWeight="Black" />
                            <TextBlock Text="JAVA LAUNCHER" FontSize="9" Foreground="{StaticResource Muted}" Margin="1,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1" Background="#302442" Margin="0,22,0,18" />
                    <TextBlock Text="LAUNCHER" Foreground="#796A94" FontSize="10" FontWeight="Bold" Margin="8,0,0,8" />
                    <Button Style="{StaticResource NavButton}" Click="NavigateHome_Click" Content="Home" Margin="0,0,0,5" />
                    <Button Style="{StaticResource NavButton}" Click="NavigateOptimizer_Click" Content="Performance optimizer" Margin="0,0,0,5" />
                    <Button Style="{StaticResource NavButton}" Click="NavigateAbout_Click" Content="About this launcher" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="20,14,20,22">
                    <Border Background="#1B142B" BorderBrush="#3B2D58" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="SERAPHYX SMP" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="Java Edition" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                            <TextBlock Text="Authentication required to join" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Independent community launcher" FontSize="10" Foreground="#786C8B" Margin="2,13,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="34,26,34,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock x:Name="PageEyebrow" Text="SERAPHYX / JAVA EDITION" FontSize="10" Foreground="#BBA8E8" FontWeight="Bold" />
                    <TextBlock x:Name="PageTitle" Text="Your realm is waiting" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#171126" BorderBrush="#3B2D58" BorderThickness="1" CornerRadius="18" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Green}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="ModeBadge" Text="PREVIEW READY" FontSize="10" Foreground="#D7CAE9" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="HomeView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#1A142A" BorderBrush="#49366C" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="THE ASCENSION BEGINS" FontSize="10" Foreground="#C6B2F2" FontWeight="Bold" />
                                    <TextBlock Text="Enter Seraphyx" FontSize="27" FontWeight="SemiBold" Margin="0,9,0,0" />
                                    <TextBlock Text="Choose a sign-in mode, set your instance, and launch directly to the server." FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="520" Margin="0,8,0,0" />
                                </StackPanel>
                                <Grid Grid.Column="1" Width="150" Height="114" Margin="24,0,0,0">
                                    <Rectangle Width="44" Height="44" Fill="#372657" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,4,0,0" />
                                    <Rectangle Width="44" Height="44" Fill="#5F438F" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,8,0" />
                                    <Rectangle Width="44" Height="44" Fill="#8E6BD3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,4" />
                                    <Rectangle Width="44" Height="44" Fill="#2B1F42" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,4" />
                                    <Rectangle Width="28" Height="28" Fill="#D9CCFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="0.95*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="19">
                                <StackPanel>
                                    <TextBlock Text="SIGN-IN MODE" FontSize="10" Foreground="#BBA8E8" FontWeight="Bold" />
                                    <ComboBox x:Name="ModeBox" Style="{StaticResource ComboField}" Margin="0,10,0,0" SelectedIndex="0" SelectionChanged="ModeBox_SelectionChanged">
                                        <ComboBoxItem Content="Preview mode — no account" Tag="Preview" />
                                        <ComboBoxItem Content="Online — Microsoft account" Tag="Online" />
                                        <ComboBoxItem Content="Offline — local single-player, no Microsoft" Tag="Offline" />
                                    </ComboBox>
                                    <TextBlock x:Name="ModeDescription" Text="Preview the launcher and optimizer without starting Minecraft." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,9,0,0" />
                                    <Button x:Name="SignInButton" Style="{StaticResource ButtonBase}" Content="Sign in with Microsoft" Click="SignIn_Click" Margin="0,14,0,0" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="AccountStatus" Text="No Microsoft profile connected" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="19">
                                <StackPanel>
                                    <TextBlock Text="LOCAL LAUNCHER PROFILE" FontSize="10" Foreground="#BBA8E8" FontWeight="Bold" />
                                    <TextBlock Text="Used as your local single-player profile" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,10" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource ButtonBase}" Content="Save" Click="SaveLocalProfile_Click" Padding="13,9" Margin="9,0,0,0" />
                                        <TextBox x:Name="LocalProfileBox" Style="{StaticResource Field}" MaxLength="16" ToolTip="Launcher display name; not a Minecraft login" />
                                    </DockPanel>
                                    <TextBlock Text="Offline mode uses this name locally. It does not grant multiplayer or server access." FontSize="10" Foreground="#A79ABF" TextWrapping="Wrap" Margin="0,9,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="19">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Row="0">
                                    <TextBlock Text="GAME SETUP" FontSize="10" Foreground="#BBA8E8" FontWeight="Bold" />
                                    <TextBlock Text="  /  Private Seraphyx instance" FontSize="10" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                                <Grid Grid.Row="1" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="0.55*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="0.5*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Minecraft version" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                                        <TextBox x:Name="VersionBox" Style="{StaticResource Field}" Text="1.21.4" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Server address" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                                        <TextBox x:Name="ServerHostBox" Style="{StaticResource Field}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Port" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                                        <TextBox x:Name="ServerPortBox" Style="{StaticResource Field}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="2" Margin="0,18,0,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="StatusText" Text="Preview mode is ready. Choose a mode above." FontSize="12" Foreground="{StaticResource Muted}" />
                                        <ProgressBar x:Name="LaunchProgress" Height="5" Minimum="0" Maximum="100" Value="0" Margin="0,9,0,0" Background="#2A203A" Foreground="#9B75EF" BorderThickness="0" Visibility="Collapsed" />
                                    </StackPanel>
                                    <Button x:Name="LaunchButton" Style="{StaticResource AccentButton}" Content="RUN PREVIEW" Click="Launch_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="22,13" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer x:Name="OptimizerView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="PERFORMANCE OPTIMIZER" FontSize="10" Foreground="#BBA8E8" FontWeight="Bold" />
                                <TextBlock Text="Tune the game instance" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Text="These settings affect the Seraphyx launcher’s separate Minecraft folder. The optimizer changes game memory and video settings; it does not run system cleaners or make registry changes." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="760" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="CHOOSE A PRESET" FontSize="10" Foreground="#BBA8E8" FontWeight="Bold" />
                                <UniformGrid Columns="3" Margin="0,13,0,0">
                                    <Button Style="{StaticResource ButtonBase}" Content="Balanced" Click="BalancedPreset_Click" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource ButtonBase}" Content="Higher FPS" Click="PerformancePreset_Click" Margin="4,0" />
                                    <Button Style="{StaticResource ButtonBase}" Content="Visual quality" Click="QualityPreset_Click" Margin="8,0,0,0" />
                                </UniformGrid>
                                <TextBlock x:Name="PresetDescription" Text="Balanced: moderate view distance and memory for typical play." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,11,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="MEMORY ALLOCATION" FontSize="10" Foreground="#BBA8E8" FontWeight="Bold" />
                                    <TextBlock x:Name="MemoryLabel" DockPanel.Dock="Right" Text="4096 MB" FontSize="13" Foreground="{StaticResource Lavender}" FontWeight="Bold" />
                                </DockPanel>
                                <Slider x:Name="MemorySlider" Minimum="2048" Maximum="8192" Value="4096" TickFrequency="512" IsSnapToTickEnabled="True" ValueChanged="MemorySlider_ValueChanged" Margin="0,14,0,0" />
                                <TextBlock Text="The slider is capped at a conservative share of detected system memory. More allocated RAM is not always faster." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#211936" BorderBrush="#544078" BorderThickness="1" CornerRadius="10" Padding="18">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="INSTANCE SETTINGS" FontSize="10" Foreground="#D9CCFF" FontWeight="Bold" />
                                    <TextBlock Text="Apply a preset to the isolated Seraphyx game profile. Existing settings are backed up before they are changed." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0" />
                                </StackPanel>
                                <Button Style="{StaticResource AccentButton}" Content="APPLY OPTIMIZATION" Click="ApplyOptimization_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AboutView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="24" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="ABOUT SERAPHYX LAUNCHER" FontSize="10" Foreground="#BBA8E8" FontWeight="Bold" />
                            <TextBlock Text="An independent launcher for Seraphyx SMP" FontSize="23" FontWeight="SemiBold" Margin="0,9,0,0" />
                            <TextBlock Text="This launcher is not affiliated with Microsoft or Mojang Studios. Microsoft sign-in is handled by the authentication library; the launcher never asks for your Microsoft password directly." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <TextBlock Text="Preview mode simulates launcher activity without launching Minecraft. Offline mode uses your local nickname for single-player and does not require Microsoft sign-in; game files may still need to download on first launch. Use Online mode and a valid Java Edition profile to connect to Seraphyx." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="2" Margin="0,17,0,0">
                <TextBlock Text="SERAPHYX COMMUNITY SOFTWARE" FontSize="9" Foreground="#756987" />
                <TextBlock x:Name="FooterHint" Text="Preview works without an account; multiplayer requires Microsoft sign-in." FontSize="10" Foreground="#9588AA" HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Grid>
</Window>

