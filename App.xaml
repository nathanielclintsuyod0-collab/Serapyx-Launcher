<Application x:Class="SeraphyxLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <LinearGradientBrush x:Key="Bg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0913" Offset="0" />
            <GradientStop Color="#141020" Offset="0.58" />
            <GradientStop Color="#1B1429" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Panel" Color="#171421" />
        <SolidColorBrush x:Key="PanelRaised" Color="#241C34" />
        <SolidColorBrush x:Key="Line" Color="#403452" />
        <SolidColorBrush x:Key="Purple" Color="#A985F7" />
        <SolidColorBrush x:Key="Lavender" Color="#E1D5FF" />
        <SolidColorBrush x:Key="Muted" Color="#A79ABF" />
        <SolidColorBrush x:Key="Green" Color="#88D8B0" />
        <SolidColorBrush x:Key="Danger" Color="#F08FA7" />

        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="#F7F2FF" />
            <Setter Property="Background" Value="{StaticResource PanelRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Purple}" />
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2A2041" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#7651C5" />
            <Setter Property="BorderBrush" Value="#A78AF1" />
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="#F5F0FF" />
            <Setter Property="Background" Value="#110E1A" />
            <Setter Property="BorderBrush" Value="#4A3B61" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CaretBrush" Value="#D9CCFF" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F5F0FF" />
            <Setter Property="Background" Value="#171421" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#302546" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3A2B56" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboField" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F5F0FF" />
            <Setter Property="Background" Value="#110E1A" />
            <Setter Property="BorderBrush" Value="#4A3B61" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}" />
            <Setter Property="MaxDropDownHeight" Value="420" />
        </Style>
    </Application.Resources>
</Application>

